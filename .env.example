# Database Configuration
MONGO_INITDB_ROOT_USERNAME=your_mongo_username
MONGO_INITDB_ROOT_PASSWORD=your_mongo_password

# Backend Configuration
NODE_ENV=production
JWT_SECRET=your-jwt-secret-key-change-this
MONGODB_URI=mongodb://your_username:your_password@mongodb:27017/edurod?authSource=admin

# Port Configuration
BACKEND_PORT=8000
# Host ports for the frontend's HTTP and HTTPS (default 80 and 443).
# Prefix with an IP to bind to one interface only, e.g. 127.0.0.1:8081
FRONTEND_PORT=80
FRONTEND_HTTPS_PORT=443

VITE_BASE_URL=http://localhost:8000